# Backend Environment Variables Template
# Copy this file to .env in the server/ folder and adjust values as needed.
# Never commit the real .env file with production credentials to GitHub.

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/school_management

# Server Port
PORT=5000

# JSON Web Token Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:3000
